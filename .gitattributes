# Auto detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Sources
*.cpp text diff=cpp
*.h   text diff=cpp
*.hpp text diff=cpp
*.c   text diff=cpp

# Lua scripts
*.lua text

# Build / project files
CMakeLists.txt text
*.cmake         text
.gitignore      text
.gitattributes  text

# Docs
*.md  text
LICENSE text

# Windows scripts should always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should always use LF
*.sh  text eol=lf

# Binary assets — do not diff, do not touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.bmp  binary
*.ico  binary
*.gif  binary
*.dds  binary

# 3D assets
*.obj  binary
*.fbx  binary
*.glb  binary
*.gltf binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z  binary

# Mark generated/vendored headers so GitHub doesn't count them in language stats
include/stb_image.h linguist-vendored
